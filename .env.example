# Copy to .env locally. Never commit a real key.
# pnpm demo calls the OpenAI Responses API when OPENAI_API_KEY is set,
# and the deterministic offline mock when it is not.
# OPENAI_API_KEY=
#
# Optional. Defaults to gpt-5.6-luna.
# OPENAI_MODEL=gpt-5.6-luna
#
# Knobs below are optional. Leave them unset for the mock path.
# FORGEFLOW_HITL=deny rejects a draft that already passed the rubric (exit 1).
# FORGEFLOW_MAX_REPAIRS must be an integer from 0 to 4. Default 2.
# pnpm demo selects live or mock from OPENAI_API_KEY.
# pnpm demo:mock always passes --mode mock. pnpm demo:live always passes --mode live.
